{
  "name": "pekanga-shared",
  "version": "0.2.0",
  "private": true,
  "description": "Shared brand tokens and headless admin UI for Pekanga products (School, Advisor, College). Not published to npm \u2014 installed via github: URL.",
  "type": "module",
  "main": "./tokens.js",
  "types": "./tokens.d.ts",
  "exports": {
    ".": {
      "types": "./tokens.d.ts",
      "default": "./tokens.js"
    },
    "./tokens.css": "./tokens.css",
    "./AdminTreeDashboard": "./AdminTreeDashboard.tsx",
    "./CareerCard": "./CareerCard.tsx",
    "./Sectors": "./Sectors.tsx",
    "./apprenticeshipMatch": "./apprenticeshipMatch.ts",
    "./ApprenticeshipMatches": "./ApprenticeshipMatches.tsx"
  },
  "files": [
    "tokens.js",
    "tokens.d.ts",
    "tokens.css",
    "AdminTreeDashboard.tsx",
    "CareerCard.tsx",
    "Sectors.tsx",
    "apprenticeshipMatch.ts",
    "ApprenticeshipMatches.tsx"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.5.0"
  }
}
